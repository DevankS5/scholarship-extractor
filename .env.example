# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Crawler identity & politeness ---
CRAWLER_USER_AGENT="ScholarshipIntelligenceBot/1.0 (+mailto:you@example.org)"

# --- Scheduler (runs inside the Next.js server process) ---
SCHEDULER_ENABLED=false
SCHEDULE_INTERVAL_MINUTES=360

# --- Optional local LLM (Ollama, free/open source). Pipeline works fully without it. ---
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Optional search-lead discovery via a self-hosted SearXNG instance (free). ---
# Results are ONLY treated as leads, never as evidence.
SEARXNG_URL=
SEARCH_QUERIES="scholarship for indian students|fellowship for indian students"

# --- Optional third-party keys. NOT required; the app never needs them. ---
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
